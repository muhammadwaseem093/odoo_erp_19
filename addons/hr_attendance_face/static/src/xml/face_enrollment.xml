<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_attendance_face.FaceEnrollmentWidget">
        <div class="face-enrollment-container">
            <div class="webcam-section" t-if="!state.hasCapture">
                <div class="video-container position-relative">
                    <video id="face-video" 
                           autoplay="true" 
                           playsinline="true"
                           class="webcam-video rounded border"/>
                    <div id="face-indicator" class="face-indicator"/>
                    <div class="face-guide-overlay"/>
                </div>
                
                <div class="mt-3 text-center">
                    <div class="face-status mb-2">
                        <span t-if="state.faceDetected" class="badge bg-success">
                            <i class="fa fa-check"/> Face Detected
                        </span>
                        <span t-else="" class="badge bg-warning">
                            <i class="fa fa-exclamation-triangle"/> Position your face in the frame
                        </span>
                    </div>
                    
                    <button t-on-click="capture" 
                            class="btn btn-primary btn-lg"
                            t-att-disabled="!state.isStreaming">
                        <i class="fa fa-camera"/> Capture
                    </button>
                </div>
                
                <div t-if="state.errorMessage" class="alert alert-danger mt-3">
                    <t t-esc="state.errorMessage"/>
                </div>
            </div>

            <div class="capture-preview-section" t-if="state.hasCapture">
                <div class="text-center">
                    <h4>Preview</h4>
                    <img id="captured-image" 
                         class="captured-image rounded border mb-3"
                         t-att-src="state.capturedImage"/>
                    
                    <div class="btn-group">
                        <button t-on-click="retake" class="btn btn-secondary">
                            <i class="fa fa-refresh"/> Retake
                        </button>
                        <button t-on-click="enroll" 
                                class="btn btn-success"
                                t-att-disabled="state.isProcessing">
                            <t t-if="state.isProcessing">
                                <i class="fa fa-spinner fa-spin"/> Processing...
                            </t>
                            <t t-else="">
                                <i class="fa fa-check"/> Enroll Face
                            </t>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
