<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Face Image Tree View -->
    <record id="view_hr_employee_face_image_tree" model="ir.ui.view">
        <field name="name">hr.employee.face.image.tree</field>
        <field name="model">hr.employee.face.image</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="image_preview" widget="image" options="{'size': [80, 80]}"/>
                <field name="direction"/>
                <field name="capture_date"/>
                <field name="is_primary"/>
            </list>
        </field>
    </record>

    <!-- Extend Employee Form View -->
    <record id="view_employee_form_face_recognition" model="ir.ui.view">
        <field name="name">hr.employee.form.face.recognition</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Face Recognition" name="face_recognition">
                    <group>
                        <group string="Face Recognition Status">
                            <field name="face_recognition_enabled"/>
                            <field name="face_enrolled" readonly="1"/>
                            <field name="face_enrollment_date" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_enroll_face" 
                                    type="object" 
                                    string="Enroll Face" 
                                    class="btn-primary"
                                    icon="fa-camera"/>
                            <button name="action_clear_face_data" 
                                    type="object" 
                                    string="Clear Face Data"
                                    class="btn-secondary"
                                    icon="fa-trash"
                                    confirm="Are you sure you want to clear all face recognition data for this employee?"/>
                        </group>
                    </group>
                    <group string="Enrolled Face Images" invisible="not face_enrolled">
                        <field name="face_image_ids" nolabel="1" mode="list"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Face Enrollment Wizard Form View -->
    <record id="view_face_enrollment_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.face.enrollment.wizard.form</field>
        <field name="model">hr.employee.face.enrollment.wizard</field>
        <field name="arch" type="xml">
            <form string="Face Enrollment">
                <sheet>
                    <group invisible="1">
                        <field name="employee_id"/>
                        <field name="enrollment_status"/>
                        <field name="face_image"/>
                        <field name="face_front"/>
                        <field name="face_left"/>
                        <field name="face_right"/>
                        <field name="face_up"/>
                        <field name="face_down"/>
                        <field name="current_step"/>
                    </group>
                    <div class="text-center mb-3">
                        <h3 style="color: #22c55e;">
                            <i class="fa fa-user-circle"/> Face Enrollment
                        </h3>
                        <p class="text-muted">Capture your face from 5 different angles</p>
                    </div>
                    <div class="face-capture-container text-center">
                        <!-- Multi-step camera UI inserted by JavaScript -->
                        <div id="webcam-container" class="rounded" style="max-width: 660px; margin: auto; min-height: 520px;">
                            <div class="d-flex align-items-center justify-content-center" style="height: 500px; background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 100%); border-radius: 12px;">
                                <div class="text-center" style="color: #22c55e;">
                                    <i class="fa fa-spinner fa-spin fa-3x mb-3"></i>
                                    <p>Initializing camera...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Employee Kanban View - Show face enrollment status -->
    <record id="view_employee_kanban_face" model="ir.ui.view">
        <field name="name">hr.employee.kanban.face</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <span t-if="record.face_enrolled.raw_value" class="badge bg-success ms-2 small">
                    <i class="fa fa-user-circle"/> Face
                </span>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="face_enrolled"/>
            </xpath>
        </field>
    </record>

</odoo>
